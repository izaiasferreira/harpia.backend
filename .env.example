# Servidor
PORT=3040
TZ=America/Sao_Paulo

# PostgreSQL
PG_CONNECTION=postgresql://user:password@host:port/dbname
PG_CONNECTION_PI=postgresql://user:password@host:port/dbname
PG_CONNECTION_MA=postgresql://user:password@host:port/dbname
PG_CONNECTION_LOCALIZACOES_PI=postgresql://user:password@host:port/dbname

# Redis
REDIS_URL=redis://default:password@host:port

# Autenticação
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_API_URL=https://telegram.izi.tec.br
TELEGRAM_API_TOKEN=your_telegram_api_token
JWT_SECRET=your_jwt_secret_min_32_chars

# CORS (separadas por vírgula, vazio = aceita tudo — NÃO use * em produção)
CORS_ORIGINS=
PUBLIC_BASE_URL=http://localhost:3040

# Admin API
ADMIN_SECRET=your_admin_secret
ADMIN_EMAIL=admin@example.com
ADMIN_SENHA=your_admin_password
ADMIN_NOME=Admin Principal

# Storage S3-compatible (Wasabi)
STORAGE_ENDPOINT=your_storage_endpoint
STORAGE_PORT=443
STORAGE_USE_SSL=true
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
STORAGE_REGION=your_region
STORAGE_BUCKET=your_bucket_name

# Legado (fallback caso STORAGE_* não definido)
MINIO_ENDPOINT=your_minio_endpoint
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET=your_bucket_name
MINIO_PUBLIC_URL=https://your_public_url
MINIO_REGION=your_region

# Imagens
IMAGE_QUALITY=80
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1080

# Metabase
METABASE_SITE_URL=http://your_metabase_url
METABASE_SECRET_KEY_GERAL=your_metabase_secret_key

# Logs
LOGS_PASSWORD=your_logs_password

# Testes
TEST_TELEGRAM_ID=your_test_telegram_id

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# Firebase (JSON da service account)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
