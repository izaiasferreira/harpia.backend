{
    "info": {
        "name": "API Banco - Admin",
        "description": "Collection for API Banco Admin routes",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3040",
            "type": "string"
        },
        {
            "key": "token",
            "value": "",
            "type": "string"
        }
    ],
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{token}}"
            }
        ]
    },
    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "string",
                "exec": [
                    "if (!pm.environment.get('token') && pm.request.url.path.includes('/login')) {",
                    "    // Skip auth for login",
                    "} else if (!pm.environment.get('token')) {",
                    "    pm.skipExecution = true;",
                    "    pm.test('Token required - update variable \"token\"', () => {});",
                    "}"
                ]
            }
        }
    ],
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "POST /admin/user/login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"admin@email.com\",\n    \"senha\": \"senha123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/admin/user/login",
                            "host": ["{{baseUrl}}"],
                            "path": ["admin", "user", "login"]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const json = pm.response.json();",
                                    "    pm.environment.set('token', json.token);",
                                    "}",
                                    "pm.test('Status 200', () => {",
                                    "    pm.expect(pm.response.code).to.be.oneOf([200, 401]);",
                                    "});"
                                ],
                                "type": "string"
                            }
                        }
                    ]
                },
